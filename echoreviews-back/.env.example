# Copia este archivo a .env antes de levantar el proyecto:
#   cp .env.example .env
#
# Los valores por defecto ya funcionan con el docker-compose.yml de este repo,
# así que puedes dejarlos tal cual para desarrollo local.

# --- Base de datos ---
DB_NAME=echoreviews_db
DB_USER=echoreviews_user
DB_PASSWORD=echoreviews_password
DB_HOST=mysql
DB_PORT=3306

# --- Django ---
# En producción esta clave debe ser secreta y distinta. Puedes generar una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-cambiar-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Desde qué orígenes acepta el navegador hablar con la API. En producción va el
# dominio del frontend desplegado. Con esquema y SIN barra final:
#   DJANGO_CORS_ORIGINS=https://echoreviews.vercel.app
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# El dominio público del propio backend, para que el admin de Django pueda
# iniciar sesión por HTTPS. En local se deja vacío:
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://echoreviews-api.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=
