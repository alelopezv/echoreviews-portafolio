# Copia este archivo a .env antes de levantar el proyecto:
#   cp .env.example .env
#
# Los valores por defecto ya funcionan con el docker-compose.yml de este repo,
# así que puedes dejarlos tal cual para desarrollo local.

# --- Base de datos ---
DB_NAME=echoreviews_db
DB_USER=echoreviews_user
DB_PASSWORD=echoreviews_password
DB_HOST=mysql
DB_PORT=3306

# --- Django ---
# En producción esta clave debe ser secreta y distinta. Puedes generar una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-cambiar-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
