# Dónde vive la API. Vite la reemplaza en el código AL COMPILAR, así que hay
# que definirla antes de `npm run build`, no después de desplegar.
#
# En desarrollo local no hace falta: sin este archivo, api.ts usa
# http://127.0.0.1:8000/api/ por defecto, que es donde la deja docker compose.
#
# Para copiarlo:  cp .env.example .env
VITE_API_URL=http://127.0.0.1:8000/api/
